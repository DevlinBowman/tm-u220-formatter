#!/usr/bin/env bash
# Captures terminal state and resolves this installation's Lua modules before launching the portable CLI entry point.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"

while [ -L "$source_path" ]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"

    case "$source_path" in
        /*) ;;
        *) source_path="$source_dir/$source_path" ;;
    esac
done

bin_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
project_root="$(cd "$bin_dir/.." && pwd)"

if [ -t 0 ]; then
    export TM_U220_STDIN_IS_TTY=1
else
    export TM_U220_STDIN_IS_TTY=0
fi

if [ -t 1 ]; then
    export TM_U220_STDOUT_IS_TTY=1
else
    export TM_U220_STDOUT_IS_TTY=0
fi

export LUA_PATH="$project_root/lua/?.lua;$project_root/lua/?/init.lua;$project_root/src/?.lua;$project_root/src/?/init.lua;${LUA_PATH:-;;}"
exec lua "$project_root/bin/tm-u220.lua" "$@"
