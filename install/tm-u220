#!/bin/sh
# Starts the repository-owned, unprivileged distribution manager after a minimal Node preflight.
set -eu

source_path=$0
while [ -L "$source_path" ]; do
    source_dir=$(CDPATH= cd -P "$(dirname "$source_path")" && pwd)
    source_path=$(readlink "$source_path")
    case "$source_path" in
        /*) ;;
        *) source_path=$source_dir/$source_path ;;
    esac
done
source_dir=$(CDPATH= cd -P "$(dirname "$source_path")" && pwd)

if ! command -v node >/dev/null 2>&1; then
    echo "TM-U220 installation requires Node.js 20.11 or newer on PATH." >&2
    exit 69
fi

exec node "$source_dir/cli.mjs" "$@"
